# PulseHub hub settings. Copy to .env to override the defaults below (the real .env is git-ignored).

# UDP port the hub listens on for device frames
PULSEHUB_UDP_PORT=9000
# HTTP port of the live dashboard
PULSEHUB_HTTP_PORT=8080
# How often the dashboard receives a fresh summary, in milliseconds
PULSEHUB_REFRESH_MS=500
# A device with no frame for this long is reported as silent, in milliseconds
PULSEHUB_SILENT_AFTER_MS=2000
# A device above this temperature is reported as hot, in °C
PULSEHUB_HOT_CELSIUS=70
