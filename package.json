{
  "name": "pulsehub",
  "version": "0.1.0",
  "private": true,
  "description": "Hub de télémétrie UDP temps réel pour équipements d'événementiel, avec simulateur",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "sim": "node src/simulator/main.ts",
    "hub": "node --env-file-if-exists=.env src/hub/main.ts",
    "bench": "node scripts/benchmark.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  }
}
